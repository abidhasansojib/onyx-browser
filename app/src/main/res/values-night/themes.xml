<resources>
    <!-- Dark AMOLED Pure Black theme -->
    <style name="Theme.OnyxBrowser" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Pure AMOLED Black #000000 background -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="colorSurface">@color/background_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOutline">@color/outline_dark</item>

        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Compatibility attributes for AppCompat & Vector drawables -->
        <item name="colorControlNormal">@color/text_primary_dark</item>
        <item name="android:colorControlNormal">@color/text_primary_dark</item>
        <item name="colorControlHighlight">#26FFFFFF</item>
        <item name="android:colorControlHighlight">#26FFFFFF</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>

        <item name="bottomSheetDialogTheme">@style/Theme.OnyxBrowser.BottomSheetDialog</item>
    </style>

    <style name="Theme.OnyxBrowser.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.OnyxBrowser.BottomSheet</item>
    </style>

    <style name="Widget.OnyxBrowser.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.OnyxBrowser.BottomSheet</item>
        <item name="backgroundTint">@color/surface_dark</item>
    </style>

    <style name="ShapeAppearance.OnyxBrowser.BottomSheet" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>
</resources>
