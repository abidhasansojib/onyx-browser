<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon foreground — references the density-specific logo PNGs
    placed in each mipmap-{density} folder.
    The logo.jpeg from /storage/emulated/0 has been resized to:
      mipmap-mdpi     : 108x108 dp  (foreground), 48x48 dp (launcher)
      mipmap-hdpi     : 162x162 dp  (foreground), 72x72 dp (launcher)
      mipmap-xhdpi    : 216x216 dp  (foreground), 96x96 dp (launcher)
      mipmap-xxhdpi   : 324x324 dp  (foreground), 144x144 dp (launcher)
      mipmap-xxxhdpi  : 432x432 dp  (foreground), 192x192 dp (launcher)
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@mipmap/ic_launcher_foreground"
    android:gravity="fill" />
