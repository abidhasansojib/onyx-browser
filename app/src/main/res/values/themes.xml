<resources>
    <!-- Base application theme: Google Light Theme -->
    <style name="Theme.OnyxBrowser" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorOnPrimaryContainer">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary</item>

        <!-- Google Light Colors (pure white background, Google search grey card borders) -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
        <item name="colorOutline">@color/outline_light</item>

        <item name="android:statusBarColor">@color/surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface_light</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Compatibility attributes for AppCompat & Vector drawables -->
        <item name="colorControlNormal">@color/text_primary_light</item>
        <item name="android:colorControlNormal">@color/text_primary_light</item>
        <item name="colorControlHighlight">#1F000000</item>
        <item name="android:colorControlHighlight">#1F000000</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>

        <!-- Global Typography: A little bold (medium weight 500) for sleek, modern UI readability -->
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>

        <item name="colorPrimaryContainer">#26DC4B64</item>
        <item name="bottomSheetDialogTheme">@style/Theme.OnyxBrowser.BottomSheetDialog</item>
    </style>

    <style name="Theme.OnyxBrowser.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.OnyxBrowser.BottomSheet</item>
    </style>

    <style name="Widget.OnyxBrowser.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.OnyxBrowser.BottomSheet</item>
        <item name="backgroundTint">@color/settings_canvas_bg</item>
    </style>

    <style name="ShapeAppearance.OnyxBrowser.BottomSheet" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerSizeTopLeft">18dp</item>
        <item name="cornerSizeTopRight">18dp</item>
    </style>

    <style name="Theme.OnyxBrowser.TabSwitcher" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsFloating">false</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorOnPrimaryContainer">@color/on_primary</item>
    </style>

    <!-- Accent Color Theme Overlays -->
    <style name="ThemeOverlay.Onyx.Accent.Crimson" parent="">
        <item name="colorPrimary">#DC4B64</item>
        <item name="colorSecondary">#DC4B64</item>
        <item name="colorPrimaryVariant">#C73A53</item>
        <item name="colorPrimaryContainer">#26DC4B64</item>
    </style>

    <style name="ThemeOverlay.Onyx.Accent.Orange" parent="">
        <item name="colorPrimary">#FF5C38</item>
        <item name="colorSecondary">#FF5C38</item>
        <item name="colorPrimaryVariant">#E04825</item>
        <item name="colorPrimaryContainer">#26FF5C38</item>
    </style>

    <style name="ThemeOverlay.Onyx.Accent.Amber" parent="">
        <item name="colorPrimary">#F59E0B</item>
        <item name="colorSecondary">#F59E0B</item>
        <item name="colorPrimaryVariant">#D97706</item>
        <item name="colorPrimaryContainer">#26F59E0B</item>
        <item name="colorOnPrimary">#000000</item>
    </style>

    <style name="ThemeOverlay.Onyx.Accent.Green" parent="">
        <item name="colorPrimary">#10C888</item>
        <item name="colorSecondary">#10C888</item>
        <item name="colorPrimaryVariant">#0EB37A</item>
        <item name="colorPrimaryContainer">#2610C888</item>
        <item name="colorOnPrimary">#000000</item>
    </style>

    <style name="ThemeOverlay.Onyx.Accent.Cyan" parent="">
        <item name="colorPrimary">#06B6D4</item>
        <item name="colorSecondary">#06B6D4</item>
        <item name="colorPrimaryVariant">#0891B2</item>
        <item name="colorPrimaryContainer">#2606B6D4</item>
        <item name="colorOnPrimary">#000000</item>
    </style>

    <!-- Backward compatibility alias for Slate -->
    <style name="ThemeOverlay.Onyx.Accent.Slate" parent="ThemeOverlay.Onyx.Accent.Cyan" />

    <style name="ThemeOverlay.Onyx.Accent.Blue" parent="">
        <item name="colorPrimary">#2F80ED</item>
        <item name="colorSecondary">#2F80ED</item>
        <item name="colorPrimaryVariant">#1D6FD8</item>
        <item name="colorPrimaryContainer">#262F80ED</item>
    </style>

    <style name="ThemeOverlay.Onyx.Accent.Violet" parent="">
        <item name="colorPrimary">#8B5CF6</item>
        <item name="colorSecondary">#8B5CF6</item>
        <item name="colorPrimaryVariant">#7C3AED</item>
        <item name="colorPrimaryContainer">#268B5CF6</item>
    </style>

    <style name="ThemeOverlay.Onyx.Accent.Pink" parent="">
        <item name="colorPrimary">#EC4899</item>
        <item name="colorSecondary">#EC4899</item>
        <item name="colorPrimaryVariant">#DB2777</item>
        <item name="colorPrimaryContainer">#26EC4899</item>
    </style>
</resources>
