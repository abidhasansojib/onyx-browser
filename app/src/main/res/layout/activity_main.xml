<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <!-- Network Status Banner -->
    <TextView
        android:id="@+id/tvNetworkStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#EA4335"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="No Internet Connection"
        tools:background="#EA4335"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Pinned Top Navigation Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/homepage_bg"
        android:elevation="0dp"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNetworkStatus">

        <!-- Unified Top Bar Box: Encloses Home, Search Engine, Search Bar, Tab Switcher, and Menu in #333439 -->
        <LinearLayout
            android:id="@+id/topBarBox"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_top_bar_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 1. Home / Back Action Container -->
            <FrameLayout
                android:id="@+id/flNavAction"
                android:layout_width="34dp"
                android:layout_height="34dp">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnHome"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/home"
                    android:padding="6dp"
                    app:srcCompat="@drawable/ic_home"
                    app:tint="?attr/colorControlNormal" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnSearchBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:padding="6dp"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_arrow_back"
                    app:tint="?attr/colorControlNormal" />
            </FrameLayout>

            <!-- 2. Search Engine Selector Icon -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnSearchEngine"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/switch_search_engine"
                android:padding="1dp"
                app:srcCompat="@drawable/ic_engine_google" />

            <!-- 3. Address / Search Bar Inner Area -->
            <LinearLayout
                android:id="@+id/searchBarContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Incognito Badge Indicator -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivIncognitoIndicator"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/incognito_mode"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_incognito"
                    app:tint="?attr/colorControlNormal" />

                <!-- SSL Lock Icon -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivSslLock"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="SSL Lock"
                    app:srcCompat="@drawable/ic_lock"
                    app:tint="?attr/colorControlNormal" />

                <!-- Address / Search EditText -->
                <EditText
                    android:id="@+id/etUrl"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:ellipsize="end"
                    android:hint="@string/search_or_type_url"
                    android:imeOptions="actionGo"
                    android:importantForAutofill="no"
                    android:inputType="textUri|textNoSuggestions"
                    android:maxLines="1"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="?android:attr/textColorSecondary"
                    android:textSize="14.5sp" />

                <!-- Clear Search Input Button -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnClearUrl"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/clear_search"
                    android:padding="2dp"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_close"
                    app:tint="?attr/colorControlNormal" />

                <!-- QR Code Scanner Button -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnQrScanner"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/qr_scan"
                    android:padding="2dp"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_qr_code"
                    app:tint="?attr/colorControlNormal" />

                <!-- Voice Search Button (Mic) -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnVoiceSearch"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/voice_search"
                    app:srcCompat="@drawable/ic_mic"
                    app:tint="?attr/colorControlNormal" />
            </LinearLayout>

            <!-- 4. Tab Switcher Badge Button -->
            <FrameLayout
                android:id="@+id/btnTabSwitcher"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tab_badge"
                android:contentDescription="@string/tabs">

                <TextView
                    android:id="@+id/tvTabCount"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- 5. Three-Dot Menu Button -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnMenu"
                android:layout_width="28dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu"
                android:padding="2dp"
                app:srcCompat="@drawable/ic_more_vert"
                app:tint="?attr/colorControlNormal" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Hidden Divider (Seamless #1C1C1E color for whole page) -->
    <View
        android:id="@+id/topBarDivider"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sleek Loading Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:elevation="6dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@android:drawable/progress_horizontal"
        android:progressTint="@color/primary"
        android:progressBackgroundTint="@android:color/transparent"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarDivider"
        tools:progress="50"
        tools:visibility="visible" />

    <!-- Find in Page Bar (Slides down under toolbar when activated) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/findInPageBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="?attr/colorSurface"
        android:elevation="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarDivider"
        tools:visibility="visible">

        <!-- Close Find in Page Button -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnCloseFind"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_close"
            app:tint="?attr/colorControlNormal" />

        <!-- Find Query EditText -->
        <EditText
            android:id="@+id/etFindQuery"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_search_bar"
            android:hint="@string/find_in_page_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnRegexToggle"
            app:layout_constraintStart_toEndOf="@id/btnCloseFind"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Regex Toggle -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnRegexToggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text=".*"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginEnd="8dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvFindMatches"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Matches Counter (e.g. 1/5) -->
        <TextView
            android:id="@+id/tvFindMatches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnFindPrev"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1/5" />

        <!-- Previous Match Button -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnFindPrev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous match"
            android:padding="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnFindNext"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_keyboard_arrow_up"
            app:tint="?attr/colorControlNormal" />

        <!-- Next Match Button -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnFindNext"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next match"
            android:padding="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_keyboard_arrow_down"
            app:tint="?attr/colorControlNormal" />

</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Translate Bar (Brave-style in-page translation toolbar) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/translateBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="?attr/colorSurface"
        android:elevation="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/findInPageBar">

        <!-- Translate Icon -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivTranslateIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_translate"
            app:tint="@color/primary" />

        <!-- Segmented Toggle: Original vs Translated -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleTranslateMode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivTranslateIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTranslateOriginal"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/translate_original"
                android:textSize="12sp"
                app:strokeColor="?attr/colorOutline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTranslateTarget"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="English"
                android:textSize="12sp"
                app:strokeColor="?attr/colorOutline" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Dropdown button to pick another target language -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnChangeTranslateLanguage"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/select_translation_language"
            android:padding="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/toggleTranslateMode"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_keyboard_arrow_down"
            app:tint="?attr/colorControlNormal" />

        <!-- Loading spinner while translation is processing -->
        <ProgressBar
            android:id="@+id/pbTranslateLoading"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:indeterminateTint="@color/primary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCloseTranslate"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Close button to dismiss translate bar -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnCloseTranslate"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_close"
            app:tint="?attr/colorControlNormal" />

        <!-- Thin bottom divider line for crisp boundary -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="?attr/colorOutline"
            android:alpha="0.3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Browser & Home View Container -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarDivider">

        <!-- Included Homepage Body -->
        <include
            android:id="@+id/homeLayout"
            layout="@layout/fragment_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- WebView Container (swapped in when active tab is on web) -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/webViewContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </FrameLayout>

    <!-- Full-Page Search Overlay (Active when user taps search bar) -->
    <LinearLayout
        android:id="@+id/searchOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?android:attr/windowBackground"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarDivider">

        <!-- Current Webpage Action Card (Share, Copy, Edit) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCurrentPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp">

                <!-- Webpage Info Row (Globe icon + Title + URL) -->
                <LinearLayout
                    android:id="@+id/containerPageInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivCurrentPageFavicon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Webpage"
                        app:srcCompat="@drawable/ic_web"
                        app:tint="?attr/colorControlNormal" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCurrentPageTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="Wikipedia, the free encyclopedia" />

                        <TextView
                            android:id="@+id/tvCurrentPageUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12sp"
                            tools:text="https://en.wikipedia.org/wiki/Main_Page" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Subtle Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="6dp"
                    android:alpha="0.2"
                    android:background="?attr/colorOutline" />

                <!-- Action Buttons: Share, Copy, Edit -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Share -->
                    <LinearLayout
                        android:id="@+id/btnCurrentPageShare"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@string/share"
                            app:srcCompat="@drawable/ic_share"
                            app:tint="?attr/colorControlNormal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/share"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Copy -->
                    <LinearLayout
                        android:id="@+id/btnCurrentPageCopy"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@string/copy"
                            app:srcCompat="@drawable/ic_copy"
                            app:tint="?attr/colorControlNormal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/copy"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Edit -->
                    <LinearLayout
                        android:id="@+id/btnCurrentPageEdit"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@string/edit"
                            app:srcCompat="@drawable/ic_edit"
                            app:tint="?attr/colorControlNormal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/edit"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Real-time Search Suggestions List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchSuggestions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="2dp"
            android:paddingBottom="16dp" />

    </LinearLayout>

    <!-- Fullscreen Video/Custom View Container -->
    <FrameLayout
        android:id="@+id/fullscreenCustomViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:elevation="100dp"
        android:visibility="gone">

        <!-- Overlay controls for PiP and exiting fullscreen -->
        <LinearLayout
            android:id="@+id/fullscreenControlsOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_search_bar"
            android:backgroundTint="#80000000"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <!-- Picture-in-Picture Button -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnFullscreenPip"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/picture_in_picture"
                android:padding="8dp"
                app:srcCompat="@drawable/ic_picture_in_picture"
                app:tint="#FFFFFF" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="#40FFFFFF" />

            <!-- Close Fullscreen Button -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnFullscreenClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:padding="8dp"
                app:srcCompat="@drawable/ic_close"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>

    <!-- Scroll-to-Top Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabScrollToTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="72dp"
        android:contentDescription="@string/scroll_to_top_title"
        android:visibility="gone"
        app:fabSize="mini"
        app:srcCompat="@drawable/ic_keyboard_arrow_up"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Incognito Locked Overlay -->
    <LinearLayout
        android:id="@+id/incognitoLockedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:elevation="100dp"
        android:visibility="gone"
        android:gravity="center"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:srcCompat="@drawable/ic_lock"
            app:tint="?attr/colorControlNormal" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Incognito Locked"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
