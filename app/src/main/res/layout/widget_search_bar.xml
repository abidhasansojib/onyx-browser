<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:paddingStart="4dp"
    android:paddingTop="2dp"
    android:paddingEnd="4dp"
    android:paddingBottom="2dp">

    <!-- Chrome / Pixel Style Stadium Capsule Search Bar -->
    <LinearLayout
        android:id="@+id/widget_search_bar_container"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_widget_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <!-- Search Input Area: Engine Icon + Hint Text -->
        <LinearLayout
            android:id="@+id/widget_btn_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Search Engine / Brand Logo -->
            <ImageView
                android:id="@+id/widget_search_engine_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="@string/search"
                android:scaleType="fitCenter" />

            <!-- Hint Text: "Search or type URL" -->
            <TextView
                android:id="@+id/widget_search_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/search_or_type_url"
                android:textColor="@color/widget_text"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Voice Search Button (Chrome circular touch ripple) -->
        <ImageView
            android:id="@+id/widget_btn_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_widget_action"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/voice_search"
            android:padding="9dp"
            android:scaleType="fitCenter" />

        <!-- Incognito Search Button (Chrome circular touch ripple) -->
        <ImageView
            android:id="@+id/widget_btn_incognito"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_widget_action"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/incognito"
            android:padding="9dp"
            android:scaleType="fitCenter" />

    </LinearLayout>

</LinearLayout>
