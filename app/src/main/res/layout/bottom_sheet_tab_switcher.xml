<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tab_switcher_bg">

    <!-- ── Top App Bar ──────────────────────────────────────────────────────── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tabSwitcherTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/tab_switcher_bg"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Left: Search / back button -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnSearchTabSwitcher"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_or_type_url"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorControlNormal" />

        <!-- Center: Normal / Incognito square segmented control with smooth round corners -->
        <LinearLayout
            android:id="@+id/tabModePillContainer"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_tab_pill_container"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 1st Button: Normal Tabs with Tab Count in rounded box (Square with smooth corners) -->
            <FrameLayout
                android:id="@+id/btnNormalTabs"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_tab_pill_selected"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/normal_tabs">

                <FrameLayout
                    android:id="@+id/boxTabCount"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_tab_count_box">

                    <TextView
                        android:id="@+id/tvNormalTabCount"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />
                </FrameLayout>
            </FrameLayout>

            <!-- 2nd Button: Incognito Tabs with Fedora Hat & Glasses Icon (Square with smooth corners) -->
            <FrameLayout
                android:id="@+id/btnIncognitoTabs"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_tab_pill_unselected"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/incognito_tabs">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivIncognitoToggle"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_incognito"
                    app:tint="#9AA0A6"
                    android:scaleType="fitCenter" />
            </FrameLayout>

        </LinearLayout>

        <!-- Right: 3-dot overflow -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnTabSwitcherOverflow"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_more_vert"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorControlNormal" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Incognito Background Watermark (Shown when viewing incognito tabs) ──── -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivIncognitoBackground"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:alpha="0.08"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabSwitcherTopBar"
        app:srcCompat="@drawable/ic_incognito"
        app:tint="#FFFFFFFF"
        tools:visibility="visible" />

    <!-- ── Empty State ──────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/emptyTabsView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabSwitcherTopBar"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivEmptyIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.22"
            app:srcCompat="@drawable/ic_logo_onyx"
            app:tint="?attr/colorControlNormal" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No tabs open"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tap + to open a new tab"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:alpha="0.6" />
    </LinearLayout>

    <!-- ── Tab Grid ─────────────────────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTabs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="10dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabSwitcherTopBar"
        app:layout_constraintWidth_max="760dp"
        app:spanCount="2"
        tools:listitem="@layout/item_tab" />

    <!-- ── Bottom Action Bar ────────────────────────────────────────────────── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="66dp"
        android:background="@color/tab_switcher_bg"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Left: Clear Browsing Data — Redesigned squircle button -->
        <FrameLayout
            android:id="@+id/btnClearHistory"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_tab_action_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/delete_browsing_data"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_delete"
                app:tint="?attr/colorControlNormal" />
        </FrameLayout>

        <!-- Center: FAB — New Tab (Decreased size to compact 42dp) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabNewTab"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/new_tab"
            app:backgroundTint="@color/tab_switcher_accent"
            app:elevation="2dp"
            app:fabCustomSize="42dp"
            app:maxImageSize="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_add"
            app:tint="#FFFFFFFF" />

        <!-- Right: Close All Tabs — Redesigned squircle button -->
        <FrameLayout
            android:id="@+id/btnCloseAllTabs"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_tab_action_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/close_all_tabs"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_tab_close"
                app:tint="?attr/colorControlNormal" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
