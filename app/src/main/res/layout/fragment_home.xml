<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- Guideline positioning brand header slightly above vertical center (40%) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.32" />

        <!-- Brand Header: Custom Geometric ONYX Vector Logo (Centered, diamond removed) -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivBrandLogo"
            android:layout_width="180dp"
            android:layout_height="56dp"
            android:contentDescription="Onyx Browser"
            app:srcCompat="@drawable/ic_logo_onyx"
            app:tint="?attr/colorControlNormal"
            app:layout_constraintBottom_toTopOf="@id/guideCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Subtitle: Fast and Private -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.06"
            android:text="@string/tagline_fast_and_private"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivBrandLogo" />

        <!-- Quick Action Box Card: 4 Elevated Modern Squircle Buttons -->
        <LinearLayout
            android:id="@+id/quickActionRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_material_box"
            android:elevation="2dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTagline"
            app:layout_constraintWidth_max="540dp">

            <!-- Action 1: Bookmarks Button -->
            <LinearLayout
                android:id="@+id/actionBookmarks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivActionBookmarks"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_box_tile"
                    android:clickable="false"
                    android:contentDescription="@string/bookmarks"
                    android:focusable="false"
                    android:padding="14dp"
                    app:srcCompat="@drawable/ic_bookmark"
                    app:tint="?attr/colorControlNormal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/bookmarks"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Action 2: Add/Manage Shortcuts Button (+) -->
            <LinearLayout
                android:id="@+id/actionAddShortcut"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivActionAddShortcut"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_box_tile"
                    android:clickable="false"
                    android:contentDescription="@string/add_shortcut"
                    android:focusable="false"
                    android:padding="14dp"
                    app:srcCompat="@drawable/ic_add"
                    app:tint="?attr/colorControlNormal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/add"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Action 3: History Button -->
            <LinearLayout
                android:id="@+id/actionHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivActionHistory"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_box_tile"
                    android:clickable="false"
                    android:contentDescription="@string/history"
                    android:focusable="false"
                    android:padding="14dp"
                    app:srcCompat="@drawable/ic_history"
                    app:tint="?attr/colorControlNormal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/history"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Action 4: Downloads Button -->
            <LinearLayout
                android:id="@+id/actionDownloads"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivActionDownloads"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_box_tile"
                    android:clickable="false"
                    android:contentDescription="@string/downloads"
                    android:focusable="false"
                    android:padding="14dp"
                    app:srcCompat="@drawable/ic_download"
                    app:tint="?attr/colorControlNormal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/downloads"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Top Sites Shortcuts Box Container (Dynamic Reorderable Grid) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvShortcuts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_material_box"
            android:elevation="2dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:padding="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/quickActionRow"
            app:layout_constraintVertical_bias="0.0"
            app:layout_constraintWidth_max="540dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
