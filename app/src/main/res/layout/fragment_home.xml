<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- Guideline positioning brand header slightly above vertical center (40%) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.32" />

        <!-- Brand Header: Custom Geometric ONYX Vector Logo (Normal Tabs) -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivBrandLogo"
            android:layout_width="180dp"
            android:layout_height="56dp"
            android:contentDescription="Onyx Browser"
            app:srcCompat="@drawable/ic_logo_onyx"
            app:tint="?attr/colorControlNormal"
            app:layout_constraintBottom_toTopOf="@id/guideCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Subtitle: Fast and Private (Normal Tabs) -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.06"
            android:text="@string/tagline_fast_and_private"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivBrandLogo" />

        <!-- Incognito Brand Header (Shown when active tab is Incognito) -->
        <LinearLayout
            android:id="@+id/incognitoHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/guideCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">

            <!-- Incognito Fedora & Glasses Logo -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivIncognitoLogo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/incognito_mode"
                app:srcCompat="@drawable/ic_incognito"
                app:tint="?attr/colorControlNormal" />

            <!-- Title: Incognito -->
            <TextView
                android:id="@+id/tvIncognitoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.04"
                android:text="@string/incognito_mode"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Subtitle / Privacy Notice -->
            <TextView
                android:id="@+id/tvIncognitoTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxWidth="340dp"
                android:text="@string/incognito_privacy_desc"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Quick Action Buttons: Clean Non-Box UI (Reorderable via Drag or Dialog, Add in 4th) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQuickActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/guideCenter"
            app:layout_constraintWidth_max="540dp" />

        <!-- Top Sites Shortcuts Box Container (Dynamic Reorderable Grid) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvShortcuts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_material_box"
            android:elevation="2dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:padding="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rvQuickActions"
            app:layout_constraintVertical_bias="0.0"
            app:layout_constraintWidth_max="540dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
