<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_circle_action"
        android:padding="8dp"
        app:tint="?attr/colorControlNormal"
        tools:srcCompat="@drawable/ic_bookmark" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="15sp"
        tools:text="Bookmarks" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnMoveUp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Move up / left"
        android:padding="8dp"
        app:srcCompat="@drawable/ic_keyboard_arrow_up"
        app:tint="?attr/colorControlNormal" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnMoveDown"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Move down / right"
        android:padding="8dp"
        app:srcCompat="@drawable/ic_keyboard_arrow_down"
        app:tint="?attr/colorControlNormal" />

</LinearLayout>
