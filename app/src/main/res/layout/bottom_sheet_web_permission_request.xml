<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/settings_canvas_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Drag handle -->
        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_drag_handle"
            android:alpha="0.4" />

        <!-- Header: Permission Icon in circle + Title & Domain -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_box_tile">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivPermissionIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_camera"
                    app:tint="?attr/colorPrimary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPermissionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="example.com wants to use your camera" />

                <TextView
                    android:id="@+id/tvPermissionHost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/settings_subtitle_text"
                    android:textSize="13sp"
                    tools:text="https://example.com" />
            </LinearLayout>
        </LinearLayout>

        <!-- Informational / Explanation Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/settings_card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/settings_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivSecurityIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    app:srcCompat="@drawable/ic_lock"
                    app:tint="@color/green_success" />

                <TextView
                    android:id="@+id/tvPermissionDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/settings_subtitle_text"
                    android:textSize="13sp"
                    tools:text="This site will only access your camera while you are viewing this page." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Option 1: Allow this time -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAllowOnce"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:text="@string/perm_dialog_allow_once"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

        <!-- Action Option 2: Always allow -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAllowAlways"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:text="@string/perm_dialog_always_allow"
            android:textSize="14sp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/settings_card_stroke" />

        <!-- Action Option 3: Block -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBlock"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/perm_dialog_block"
            android:textColor="?attr/colorError"
            android:textSize="14sp"
            app:cornerRadius="14dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
