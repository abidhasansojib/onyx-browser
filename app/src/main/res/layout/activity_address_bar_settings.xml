<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/addressBarSettingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_canvas_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/settings_canvas_bg"
        android:stateListAnimator="@null"
        app:backgroundTint="@color/settings_canvas_bg"
        app:elevation="0dp"
        app:liftOnScroll="false"
        app:statusBarForeground="@null">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/settings_canvas_bg"
            app:backgroundTint="@color/settings_canvas_bg"
            app:elevation="0dp"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/settings_title_text"
            app:title="@string/address_bar_customization"
            app:titleTextColor="@color/settings_title_text" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="40dp">

            <!-- Section Header: Edit Address Bar -->
            <TextView
                android:id="@+id/tvEditAddressBarHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.08"
                android:text="EDIT ADDRESS BAR"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Main Floating Container Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAddressBarPositionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#1C1C1E"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeColor="#1FFFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <!-- Option 1: Top Address Bar -->
                    <FrameLayout
                        android:id="@+id/optTopAddressBar"
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_address_bar_option_selected"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <!-- Phone Graphic Container (Top Half) -->
                            <FrameLayout
                                android:layout_width="90dp"
                                android:layout_height="72dp"
                                android:layout_marginTop="16dp">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    app:srcCompat="@drawable/vector_phone_top_silhouette" />

                                <View
                                    android:id="@+id/pillTopPreview"
                                    android:layout_width="56dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center_horizontal|top"
                                    android:layout_marginTop="14dp"
                                    android:background="@drawable/bg_address_bar_pill" />
                            </FrameLayout>

                            <!-- Selection Badge Container -->
                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp">

                                <View
                                    android:id="@+id/radioTopUnselected"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:background="@drawable/bg_address_bar_radio_unselected"
                                    android:visibility="gone" />

                                <FrameLayout
                                    android:id="@+id/badgeTopSelected"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:background="@drawable/bg_address_bar_check_badge">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_gravity="center"
                                        app:srcCompat="@drawable/ic_check"
                                        app:tint="#FFFFFF" />
                                </FrameLayout>
                            </FrameLayout>
                        </LinearLayout>
                    </FrameLayout>

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="match_parent" />

                    <!-- Option 2: Bottom Address Bar -->
                    <FrameLayout
                        android:id="@+id/optBottomAddressBar"
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_address_bar_option_unselected"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <!-- Phone Graphic Container (Bottom Half) -->
                            <FrameLayout
                                android:layout_width="90dp"
                                android:layout_height="72dp"
                                android:layout_marginTop="16dp">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    app:srcCompat="@drawable/vector_phone_bottom_silhouette" />

                                <View
                                    android:id="@+id/pillBottomPreview"
                                    android:layout_width="56dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center_horizontal|bottom"
                                    android:layout_marginBottom="14dp"
                                    android:background="@drawable/bg_address_bar_pill" />
                            </FrameLayout>

                            <!-- Selection Badge Container -->
                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp">

                                <View
                                    android:id="@+id/radioBottomUnselected"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:background="@drawable/bg_address_bar_radio_unselected" />

                                <FrameLayout
                                    android:id="@+id/badgeBottomSelected"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:background="@drawable/bg_address_bar_check_badge"
                                    android:visibility="gone">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_gravity="center"
                                        app:srcCompat="@drawable/ic_check"
                                        app:tint="#FFFFFF" />
                                </FrameLayout>
                            </FrameLayout>
                        </LinearLayout>
                    </FrameLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 1 Header: Toolbar Buttons -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.08"
                android:text="@string/toolbar_buttons_category"
                android:textColor="@color/settings_subtitle_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Replace Home with Refresh Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReplaceHomeWithRefresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/settings_card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/settings_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_box_tile">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_refresh"
                            app:tint="@color/settings_title_text" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/replace_home_with_refresh"
                            android:textColor="@color/settings_title_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/replace_home_with_refresh_desc"
                            android:textColor="@color/settings_subtitle_text"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchReplaceHomeWithRefresh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2 Header: Toolbar Behavior -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.08"
                android:text="TOOLBAR BEHAVIOR"
                android:textColor="@color/settings_subtitle_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Auto-hide Toolbar on Scroll -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAutoHideToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/settings_card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/settings_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_box_tile">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_aspect_ratio"
                            app:tint="@color/settings_title_text" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_hide_toolbar_title"
                            android:textColor="@color/settings_title_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/auto_hide_toolbar_desc"
                            android:textColor="@color/settings_subtitle_text"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutoHideToolbar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>